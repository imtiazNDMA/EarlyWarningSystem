  "info": {
    "title": "Early Warning System API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/air-quality": {
      "get": {
        "description": "Latest PM2.5 value for every district with stored air-quality data.",
        "operationId": "all_air_quality_api_air_quality_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AirQualityOut"
                  },
                  "title": "Response All Air Quality Api Air Quality Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "All Air Quality",
        "tags": [
          "air quality"
        ]
      }
    },
    "/api/alerts": {
      "get": {
        "description": "Alerts, newest first. With no filters this is the full alert history.",
        "operationId": "alerts_api_alerts_get",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "active",
                    "superseded",
                    "cancelled",
                    "expired"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "description": "Case-insensitive",
            "in": "query",
            "name": "province",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Case-insensitive",
              "title": "Province"
            }
          },
          {
            "in": "query",
            "name": "hazard",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Hazard"
            }
          },
          {
            "in": "query",
            "name": "severity",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "moderate",
                    "severe",
                    "extreme"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Severity"
            }
          },
          {
            "in": "query",
            "name": "district_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "District Id"
            }
          },
          {
            "in": "query",
            "name": "issued_since",
            "required": false,
            "schema": {
              "anyOf": [
                {
