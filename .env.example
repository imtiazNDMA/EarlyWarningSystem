# Environment Configuration for NEOC Early Warning System
# Copy this file to .env and fill in your actual configurations

# LLM Configuration (OpenAI-compatible server: LM Studio / vLLM / llama.cpp)
# Point LLM_BASE_URL at the server root + /v1, e.g. http://<host>:1234/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_BASE_URL=http://172.18.1.135:1234/v1
LLM_API_KEY=lm-studio
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=180
LLM_MAX_RETRIES=2

# Mapbox Configuration
MAPBOX_TOKEN=your_mapbox_token_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key_here_change_in_production

# Application Configuration
CACHE_TIME=43200
BASE_URL=https://api.open-meteo.com/v1/forecast

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=app.log