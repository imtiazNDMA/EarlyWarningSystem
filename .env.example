# Environment Configuration for NEOC Early Warning System
# Copy this file to .env and fill in your actual configurations

# LM Studio OpenAI-compatible local server
LM_STUDIO_MODEL=zai-org/glm-4.7-flash
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key_here_change_in_production

# Application Configuration
CACHE_TIME=43200
BASE_URL=https://api.open-meteo.com/v1/forecast
API_TIMEOUT=120
TIMEZONE=Asia/Karachi
FORECAST_FRESH_SECONDS=10800
FORECAST_STALE_SECONDS=21600

# MongoDB persistence
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=early_warnings
MONGODB_TIMEOUT_MS=5000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=app.log
