# Enables POST /api/runs. Send the same value in the X-Admin-Token header.
EWS_ADMIN_TOKEN=change-me

# Language model provider: lm_studio (default, local) or groq (cloud).
# EWS_LLM_PROVIDER=lm_studio
# Under Docker Compose, LM Studio on this machine is reached through the host:
# EWS_LLM_BASE_URL=http://host.docker.internal:1234/v1
# Unset uses whichever model LM Studio has loaded, or openai/gpt-oss-120b on Groq.
# EWS_LLM_MODEL=
# Required when the provider is groq; the API refuses to start without it.
# EWS_LLM_API_KEY=

# Optional host-port overrides for Docker Compose.
EWS_DB_PORT=5434
EWS_API_PORT=8000
EWS_WEB_PORT=5173
